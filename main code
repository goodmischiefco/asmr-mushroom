// ==========================================
// v0.9 REAL WET SPONGE AUDIO
// ==========================================

// Audio is loaded from public/wet-sponge.mp3.
// We play short slices of the recording.
// All audio is real Foley, not synthesized.

let audioContext = null;
let spongeBuffer = null;
let audioPromise = null;
let masterGain = null;
let lastDragSound = 0;

const SOUND_VOLUME = 0.75;

// Candidate sections from the 30.7-second file.
// We can refine the exact timings after listening
// to how these clips behave in the game.

const soundClips = {
  press: [
    { start: 10.2, duration: 0.42 },
    { start: 11.0, duration: 0.38 },
    { start: 20.2, duration: 0.45 }
  ],
  drag: [
    { start: 10.8, duration: 0.27 },
    { start: 21.0, duration: 0.30 },
    { start: 22.0, duration: 0.26 }
  ],
  release: [
    { start: 11.5, duration: 0.30 },
    { start: 20.9, duration: 0.32 },
    { start: 22.5, duration: 0.35 }
  ]
};

async function initAudio() {
  if (!audioContext) {
    const AudioContextClass =
      window.AudioContext || window.webkitAudioContext;

    if (!AudioContextClass) {
      console.warn('Web Audio is not supported.');
      return;
    }

    audioContext = new AudioContextClass();

    masterGain = audioContext.createGain();
    masterGain.gain.value = SOUND_VOLUME;
    masterGain.connect(audioContext.destination);
  }

  if (audioContext.state === 'suspended') {
    await audioContext.resume();
  }

  if (!audioPromise) {
    audioPromise = (async () => {
      const response = await fetch('/wet-sponge.mp3');

      if (!response.ok) {
        throw new Error(
          'Could not load wet-sponge.mp3. Check the public folder.'
        );
      }

      const bytes = await response.arrayBuffer();
      spongeBuffer = await audioContext.decodeAudioData(bytes);

      console.log(
        'Wet sponge audio loaded:',
        spongeBuffer.duration.toFixed(2),
        'seconds'
      );
    })().catch(error => {
      audioPromise = null;
      console.error('Mushroom audio error:', error);
    });
  }

  await audioPromise;
}

function chooseClip(type) {
  const options = soundClips[type];

  return options[
    Math.floor(Math.random() * options.length)
  ];
}

function playSponge(type = 'press') {
  if (
    !audioContext ||
    !spongeBuffer ||
    audioContext.state !== 'running'
  ) return;

  const clip = chooseClip(type);
  const now = audioContext.currentTime;

  const start = Math.min(
    clip.start,
    spongeBuffer.duration - 0.05
  );

  const duration = Math.min(
    clip.duration,
    spongeBuffer.duration - start
  );

  if (duration <= 0.02) return;

  const source = audioContext.createBufferSource();
  source.buffer = spongeBuffer;

  // Tiny pitch variations make repeat presses
  // feel less identical.
  source.playbackRate.value =
    0.94 + Math.random() * 0.12;

  const filter = audioContext.createBiquadFilter();
  filter.type = 'highpass';
  filter.frequency.value = 100;

  const gain = audioContext.createGain();

  const volume =
    type === 'press' ? 0.9 :
    type === 'drag' ? 0.55 : 0.7;

  // Smooth fade-in and fade-out prevent clicks.
  const fadeIn = Math.min(0.018, duration * 0.2);
  const fadeOut = Math.min(0.075, duration * 0.3);

  gain.gain.setValueAtTime(0, now);
  gain.gain.linearRampToValueAtTime(
    volume, now + fadeIn
  );

  gain.gain.setValueAtTime(
    volume,
    now + Math.max(fadeIn, duration - fadeOut)
  );

  gain.gain.linearRampToValueAtTime(
    0,
    now + duration
  );

  source.connect(filter);
  filter.connect(gain);
  gain.connect(masterGain);

  source.start(now, start, duration);
  source.stop(now + duration + 0.02);

  source.onended = () => {
    source.disconnect();
    filter.disconnect();
    gain.disconnect();
  };
}

// ==========================================
// ORIGINAL LOCALIZED SQUISH PHYSICS
// ==========================================

const raycaster = new THREE.Raycaster();
const pointer = new THREE.Vector2();

const positions = capGeometry.attributes.position;
const originals = new Float32Array(positions.array);
const offsets = new Float32Array(positions.count);
const velocities = new Float32Array(positions.count);

let activePointer = null;
let contact = null;
let pressed = false;
let pressure = 0;
let holdSoundPlayed = false;
let pressStartTime = 0;

const radius = 0.46;
const maxDepth = 0.32;

function getContact(event) {
  const rect =
    renderer.domElement.getBoundingClientRect();

  pointer.x =
    ((event.clientX - rect.left) / rect.width) * 2 - 1;

  pointer.y =
    -((event.clientY - rect.top) / rect.height) * 2 + 1;

  raycaster.setFromCamera(pointer, camera);

  const hits = raycaster.intersectObject(cap);
  if (!hits.length) return null;

  const point = hits[0].point.clone();
  cap.worldToLocal(point);

  return point;
}

// PRESS
renderer.domElement.addEventListener(
  'pointerdown',
  (event) => {
    if (activePointer !== null) return;

    const point = getContact(event);
    if (!point) return;

    activePointer = event.pointerId;
    contact = point;
    pressed = true;
    pressure = 0;
    holdSoundPlayed = false;
    pressStartTime = performance.now();

    renderer.domElement.setPointerCapture(
      event.pointerId
    );

    // Audio loads on first interaction.
    // Subsequent presses play immediately.
    if (spongeBuffer) {
      playSponge('press');
    } else {
      initAudio().then(() => {
        if (pressed) playSponge('press');
      });
    }
  }
);

// DRAG
renderer.domElement.addEventListener(
  'pointermove',
  (event) => {
    if (
      event.pointerId !== activePointer ||
      !pressed
    ) return;

    const point = getContact(event);

    if (point) {
      const distance = contact
        ? point.distanceTo(contact)
        : 0;

      contact = point;

      const now = performance.now();

      // Only play a drag sound for meaningful
      // movement, avoiding constant overlapping.
      if (
        distance > 0.045 &&
        now - lastDragSound > 190
      ) {
        playSponge('drag');
        lastDragSound = now;
      }
    }
  }
);

// RELEASE
function release(event) {
  if (event.pointerId !== activePointer) return;

  pressed = false;
  activePointer = null;

  playSponge('release');
}

renderer.domElement.addEventListener(
  'pointerup', release
);
renderer.domElement.addEventListener(
  'pointercancel', release
);

window.addEventListener('blur', () => {
  pressed = false;
  activePointer = null;
});

// SPRING PHYSICS
const clock = new THREE.Clock();

function updateSquish(delta) {
  const dt = Math.min(delta, 0.033);

  pressure +=
    ((pressed ? 1 : 0) - pressure) *
    Math.min(1, dt * 10);

  // One subtle compression sound during a hold.
  if (
    pressed &&
    !holdSoundPlayed &&
    performance.now() - pressStartTime > 250
  ) {
    playSponge('drag');
    holdSoundPlayed = true;
  }

  const stiffness = 145;
  const damping = 15;

  let moving = false;

  for (let i = 0; i < positions.count; i++) {
    const j = i * 3;

    const x = originals[j];
    const y = originals[j + 1];
    const z = originals[j + 2];

    let target = 0;

    if (contact && pressure > 0.001) {
      const dx = x - contact.x;
      const dy = y - contact.y;
      const dz = z - contact.z;

      const d2 =
        dx * dx +
        dy * dy +
        dz * dz;

      const influence = Math.exp(
        -d2 / (radius * radius)
      );

      const d = Math.sqrt(d2);

      const bulge = Math.exp(
        -Math.pow(
          (d - radius * 1.45) /
          (radius * 0.42),
          2
        )
      ) * 0.035;

      target =
        -maxDepth * pressure * influence +
        bulge * pressure;
    }

    const acceleration =
      (target - offsets[i]) * stiffness -
      velocities[i] * damping;

    velocities[i] += acceleration * dt;
    offsets[i] += velocities[i] * dt;

    offsets[i] = THREE.MathUtils.clamp(
      offsets[i],
      -0.42,
      0.12
    );

    positions.setXYZ(
      i,
      x,
      y + offsets[i],
      z
    );

    if (
      Math.abs(offsets[i]) > 0.0002 ||
      Math.abs(velocities[i]) > 0.0002
    ) {
      moving = true;
    }
  }

  if (moving || pressed) {
    positions.needsUpdate = true;
    capGeometry.computeVertexNormals();
  }
}

// ANIMATION
function animate() {
  requestAnimationFrame(animate);

  updateSquish(clock.getDelta());

  renderer.render(scene, camera);
}

// RESIZE
window.addEventListener('resize', () => {
  camera.aspect =
    window.innerWidth / window.innerHeight;

  camera.updateProjectionMatrix();

  renderer.setSize(
    window.innerWidth,
    window.innerHeight
  );
});

animate();
